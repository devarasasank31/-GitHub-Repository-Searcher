# Copy to .env and adjust values. Never commit .env.

# PostgreSQL
POSTGRES_DB=github_searcher
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Application
SERVER_PORT=8080

# GitHub API. A token raises the search rate limit from 10 to 30 requests
# per minute; leave empty for unauthenticated access.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
