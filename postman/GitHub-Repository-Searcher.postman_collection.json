            },
            "url": {
              "raw": "{{baseUrl}}/api/github/search",
              "host": ["{{baseUrl}}"],
              "path": ["api", "github", "search"]
            },
            "description": "Rate limiting (429), GitHub auth/upstream failures (502) and unreachability (503) depend on GitHub's live state and are exercised deterministically by the automated tests (WireMock), not by this request. To reproduce locally: point GITHUB_API_BASE_URL at a stub returning 429/500/401, or exhaust the unauthenticated GitHub rate limit (10 searches/min without a token)."
          }
        }
